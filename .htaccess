# Server settings for Apache hosting.
# Hidden file: make sure your FTP client shows hidden files so it gets uploaded.

ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest
AddDefaultCharset utf-8
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS required
  RewriteCond %{SERVER_PORT} 80
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  # a single address, without "www"
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  # working files are never served, even if uploaded by mistake
  RewriteRule ^(tests|README\.md)(/|$) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  # pages and code: always check for a newer version
  <FilesMatch "\.(html|js|css|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # font and images: kept for 30 days
  <FilesMatch "\.(woff2|png|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
